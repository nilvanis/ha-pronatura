{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant: ProNatura",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "homeassistant",
      "args": ["--config", "${workspaceFolder}/config"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "HA: prepare",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: unit tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "pytest",
      "args": ["tests", "--no-cov"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
